{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Åkaren — debug server + start client",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server/index.js",
      "cwd": "${workspaceFolder}/server",
      "envFile": "${workspaceFolder}/server/.env",
      "preLaunchTask": "client: vite dev",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/server/node_modules/**"]
    }
  ]
}
