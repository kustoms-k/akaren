# The public demo. Copy to deploy/demo.env. Use DIFFERENT secrets from app.env.
# DEMO_MODE, DEMO_AUTO_RESET and the blanked API keys are forced by compose.yaml: the demo never costs money
# and never sends a real SMS or email.
JWT_SECRET=
ENCRYPTION_KEY=
APP_URL=https://demo.example.se
PUBLIC_BASE_URL=https://demo.example.se
