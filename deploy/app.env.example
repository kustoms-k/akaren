# The real app. Copy to deploy/app.env and fill in. NODE_ENV, DATA_DIR and TRUST_PROXY are set by compose.yaml.
# Generate each secret with: openssl rand -hex 32
JWT_SECRET=
ENCRYPTION_KEY=

# The office and the driver links use the same address.
APP_URL=https://app.example.se
PUBLIC_BASE_URL=https://app.example.se

DRIVER_LINK_MAX_DAYS=7
RETENTION_MONTHS_DEFAULT=36

# AI (orders and vågsedlar). Without a key the AI endpoints say so; nothing is faked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_MONTHLY_BUDGET_USD=30

# SMS to drivers (46elks). Blank = simulated (logged).
ELKS_USERNAME=
ELKS_PASSWORD=
ELKS_SENDER=Akaren

# Order confirmation emails. Blank = simulated (logged and stored, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Fortnox: register the app at developer.fortnox.se with exactly this redirect URI.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=https://app.example.se/api/fortnox/callback
