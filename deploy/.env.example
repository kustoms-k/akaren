# Copy to deploy/.env. Read by docker compose for the domains and the certificate email.
# Both domains need a DNS A record pointing at this server before the first start.
APP_DOMAIN=app.example.se
DEMO_DOMAIN=demo.example.se
# Let's Encrypt sends expiry warnings here (rarely needed: Caddy renews automatically).
ACME_EMAIL=you@example.se
# Optional: a host folder for the second copy of the nightly backup, e.g. a mounted storage box.
# Leave unset to keep it in a Docker volume on the same server (then copy it off the server; see README).
# BACKUP_PATH=/mnt/storagebox/akaren
