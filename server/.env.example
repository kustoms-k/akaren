# Åkaren: copy to server/.env and fill in. The root scripts, the server and the
# Vite dev server all read this one file. Never commit the real .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 0.0.0.0 lets a phone on the same Wi-Fi reach the app (driver links).
HOST=0.0.0.0
PORT=3002
# Database (akaren.db), photos/ and backups/. Relative paths resolve from server/.
DATA_DIR=./data
# Optional second copy of nightly backups, e.g. an external disk.
BACKUP_DIR=

# ── URLs ──────────────────────────────────────────────────────────────────────
# Office UI. Used for the redirect back after connecting Fortnox.
APP_URL=http://localhost:5173
# Base for driver magic links sent by SMS. Must be reachable from the driver's phone:
# use the laptop's LAN IP (`ipconfig getifaddr en0`), ideally a fixed DHCP reservation.
PUBLIC_BASE_URL=http://192.168.1.50:5173
# Extra allowed browser origins, comma separated.
CORS_ORIGINS=
# Where the Vite dev server proxies /api.
VITE_API_TARGET=http://localhost:3002
VITE_PORT=5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Both are required; the server won't start without them.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts Fortnox tokens at rest (64 hex characters).
ENCRYPTION_KEY=
# Longest a driver magic link stays valid, in days.
DRIVER_LINK_MAX_DAYS=7

# ── Anthropic (order intake + vågsedel extraction) ────────────────────────────
# Without a key the AI endpoints return a clear error. There is no fake fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional: override the API base URL (tests / proxies).
ANTHROPIC_BASE_URL=
# Hard monthly cap on estimated AI spend (USD, list price). 0 turns AI off.
# Roughly $0.02–0.03 per order or vågsedel with claude-opus-5.
AI_MONTHLY_BUDGET_USD=30

# ── 46elks (SMS) ──────────────────────────────────────────────────────────────
# Leave username/password blank to simulate SMS (printed to the server console).
ELKS_USERNAME=
ELKS_PASSWORD=
# Sender name: 2–11 characters, A–Z a–z 0–9 only (no å/ä/ö), starting with a letter.
ELKS_SENDER=Akaren
ELKS_API_BASE=https://api.46elks.com/a1

# ── Fortnox (draft invoices + customer sync) ──────────────────────────────────
# Register the app at https://developer.fortnox.se and add the redirect URI there.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=http://localhost:3002/api/fortnox/callback
FORTNOX_AUTH_BASE=https://apps.fortnox.se/oauth-v1
FORTNOX_API_BASE=https://api.fortnox.se/3

# ── Data retention ────────────────────────────────────────────────────────────
# Default for new companies; each company can change it under Inställningar.
RETENTION_MONTHS_DEFAULT=36

# ── Demo seed ─────────────────────────────────────────────────────────────────
# Password for kontor@testakeriet.se when running `npm run seed`. Random if blank.
SEED_PASSWORD=
