# Lasskoll: copy to server/.env and fill in. The root scripts, the server and the
# Vite dev server all read this one file. Never commit the real .env.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# 0.0.0.0 lets a phone on the same Wi-Fi reach the app (driver links).
HOST=0.0.0.0
PORT=3002
# Database (akaren.db), photos/ and backups/. Relative paths resolve from server/.
DATA_DIR=./data
# Optional second copy of the nightly database backup and of the vågsedel photos, e.g. an external disk.
# Photos deleted by the retention job are removed from this copy too.
BACKUP_DIR=

# ── URLs ──────────────────────────────────────────────────────────────────────
# Office UI. Used for the redirect back after connecting Fortnox.
APP_URL=http://localhost:5173
# Base for driver magic links sent by SMS. Must be reachable from the driver's phone:
# use the laptop's LAN IP, ideally a fixed DHCP reservation in the router.
#   Windows: `ipconfig`, the "IPv4 Address" of the Wi-Fi adapter. Also allow Node.js through
#            Windows Defender Firewall on private networks, or the phone can't connect.
#   macOS:   `ipconfig getifaddr en0`
PUBLIC_BASE_URL=http://192.168.1.50:5173
# Extra allowed browser origins, comma separated.
CORS_ORIGINS=
# Where the Vite dev server proxies /api.
VITE_API_TARGET=http://localhost:3002
VITE_PORT=5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# Both are required; the server won't start without them.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Encrypts Fortnox tokens at rest (64 hex characters).
ENCRYPTION_KEY=
# Longest a driver magic link stays valid, in days.
DRIVER_LINK_MAX_DAYS=7

# ── Anthropic (order intake + vågsedel extraction) ────────────────────────────
# Without a key the AI endpoints return a clear error. There is no fake fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional: override the API base URL (tests / proxies).
ANTHROPIC_BASE_URL=
# Hard monthly cap on estimated AI spend (USD, list price). 0 turns AI off.
# Roughly $0.02–0.03 per order or vågsedel with claude-opus-5.
AI_MONTHLY_BUDGET_USD=30
# Local demos only (refused when NODE_ENV=production): with no API key, the order inbox shows
# sample orders and returns pre-written extractions for exactly those texts. Anything else is rejected.
# It also makes the login button work with empty fields (logs in as the first office user), so anyone
# who can reach the app on the LAN gets in. Never enable it with real customer data.
DEMO_MODE=0

# ── 46elks (SMS) ──────────────────────────────────────────────────────────────
# Leave username/password blank to simulate SMS (printed to the server console).
ELKS_USERNAME=
ELKS_PASSWORD=
# Sender name: 2–11 characters, A–Z a–z 0–9 only (no å/ä/ö), starting with a letter.
ELKS_SENDER=Lasskoll
ELKS_API_BASE=https://api.46elks.com/a1

# ── Email: order confirmations (orderbekräftelse) ─────────────────────────────
# Without SMTP_HOST and MAIL_FROM, emails are simulated: logged to the console and stored, not sent.
# Replies always go to the company email set under Inställningar (Reply-To).
#   Google Workspace:  smtp.gmail.com, 587, the mailbox address + an app password (needs 2-step verification)
#   Microsoft 365:     smtp.office365.com, 587. SMTP AUTH with a password is off by default for tenants
#                      from end of 2026; an admin can re-enable it per mailbox, or use a provider below.
#   Brevo / Mailjet:   EU-hosted SMTP relays. Verify your domain (SPF + DKIM) in their dashboard first,
#                      otherwise Gmail and Outlook will put the confirmations in spam.
# Port 465 uses TLS directly; 587 upgrades with STARTTLS (required).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address, e.g. kontor@ert-akeri.se. The display name is the company name from Inställningar.
MAIL_FROM=

# ── Fortnox (draft invoices + customer sync) ──────────────────────────────────
# Register the app at https://developer.fortnox.se and add the redirect URI there.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
FORTNOX_REDIRECT_URI=http://localhost:3002/api/fortnox/callback
FORTNOX_AUTH_BASE=https://apps.fortnox.se/oauth-v1
FORTNOX_API_BASE=https://api.fortnox.se/3

# ── Data retention ────────────────────────────────────────────────────────────
# Default for new companies; each company can change it under Inställningar.
RETENTION_MONTHS_DEFAULT=36

# ── Demo seed ─────────────────────────────────────────────────────────────────
# Password for kontor@testakeriet.se when running `npm run seed`. Random if blank.
SEED_PASSWORD=
